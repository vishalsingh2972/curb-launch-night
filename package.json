{
  "name": "curb-launch-night",
  "private": true,
  "type": "module",
  "curb": {
    "requiredRuntimeSecrets": [
      "KUGELAUDIO_API_KEY"
    ]
  },
  "scripts": {
    "dev": "curb dev",
    "check": "curb check",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:deterministic",
    "test:deterministic": "node --test tests/incident.test.mjs",
    "start": "curb start",
    "server": "curb server",
    "upgrade": "curb upgrade"
  },
  "allowScripts": {
    "@livekit/blingfire": false,
    "@livekit/local-inference": false,
    "esbuild": false,
    "fsevents": false,
    "onnxruntime-node": false
  },
  "dependencies": {
    "curb": "npm:curb.js@1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-reconciler": "^0.33.0",
    "typescript": "^6.0.3"
  }
}
